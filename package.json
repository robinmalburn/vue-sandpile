{
    "name": "vue-sandpile",
    "version": "2.0.6",
    "description": "A javascript implementation of the Abelian sandpile model using Canvas, Vue and Vuex.",
    "repository": {
        "type": "git",
        "url": "https://github.com/robinmalburn/vue-sandpile.git"
    },
    "main": "src/js/index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "vite",
        "prod": "vite build",
        "watch": "vite build --watch",
        "start": "vite --open"
    },
    "keywords": [
        "sandpile"
    ],
    "author": "Robin Malburn <robin.malburn@googlemail.com>",
    "license": "MIT",
    "dependencies": {
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-color": "^3.3.3"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/compiler-sfc": "^3.5.43",
        "vite": "^8.3.1"
    },
    "engines": {
        "runtime": {
            "name": "node",
            "version": "^24.21.0",
            "onFail": "download"
        }
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.16.0",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.8.1",
            "onFail": "warn"
        }
    }
}
